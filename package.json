  },
  "scripts": {
    "test": "vitest run",
    "check": "node scripts/check-package.mjs"
  },
  "license": "MIT",
  "author": "leCielEtoile",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leCielEtoile/emdash-plugin-deploy-trigger.git"
  },
